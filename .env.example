NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Cloudflare R2 credentials. Never prefix these with NEXT_PUBLIC_.
R2_TOKEN=your-r2-api-token
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_JURISDICTION_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=medpartner-dev

# Server-only Gemini Interactions API configuration.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_AUDIO_MODEL=gemini-2.5-flash
GEMINI_AUDIO_STRUCTURING_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Optional server-only provider for AI SDK chat. Never prefix with NEXT_PUBLIC_.
INCEPTION_API_KEY=your-inception-api-key
